{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "borrowed-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "borrowed-media",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icon*.png", "/icon.svg", "/**/*.(svg|png|jpg|jpeg|webp|avif|woff2)"]
      }
    }
  ]
}
