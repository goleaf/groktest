{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--isolated",
        "--headless",
        "--viewport-size",
        "1440x900",
        "--console-level",
        "warning",
        "--output-dir",
        "/tmp/borrowed-playwright-mcp",
        "--output-max-size",
        "52428800"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--channel=stable",
        "--isolated",
        "--headless",
        "--viewport=1440x900",
        "--redact-network-headers",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
