{
  "name": "borrowed",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:deployment": "node --test deploy/deployment-contract.test.mjs",
    "typecheck": "ng build --configuration development",
    "lint": "pnpm lint:eslint && pnpm lint:format",
    "lint:eslint": "ng lint",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "desktop": "pnpm start",
    "electron": "electron electron/main.cjs",
    "mobile:doctor": "cap doctor",
    "mobile:sync": "pnpm build && cap sync"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.3",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "dexie": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "electron": "^43.4.1",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
